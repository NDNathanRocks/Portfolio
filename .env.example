# Copy to .env.local and fill in. Never commit .env.local.
RESEND_API_KEY=
# Inbox that receives contact-form messages. With an unverified Resend domain this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional. Defaults to Resend's shared onboarding sender.
CONTACT_FROM=

# Optional. Live AI task breakdown in the Clarity demo. Gemini is tried first, then Groq; with neither (or on any failure) the demo uses its in-browser rule engine.
GEMINI_API_KEY=
GROQ_API_KEY=
